{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verity-terminal",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
